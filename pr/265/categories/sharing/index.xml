 &lt;th>Comment&lt;/th>
 &lt;/tr>
 &lt;/thead>
 &lt;tbody>
 &lt;tr>
 &lt;td>&lt;code>id&lt;/code>&lt;/td>
 &lt;td>&lt;strong>Yes&lt;/strong>&lt;/td>
 &lt;td>&lt;/td>
 &lt;td>&lt;/td>
 &lt;td>ID of the share to delete.&lt;/td>
 &lt;/tr>
 &lt;/tbody>
&lt;/table>
